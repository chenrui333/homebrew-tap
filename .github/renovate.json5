{
  extends: [
    'config:recommended',
    'docker:pinDigests',
    'helpers:pinGitHubActionDigests',
    ':configMigration',
    ':pinDevDependencies',
  ],
  commitMessagePrefix: 'chore(deps):',
  commitMessageSuffix: ' in {{packageFile}}',
  automerge: true,
  automergeType: 'pr',
  automergeStrategy: 'merge-commit',
  baseBranchPatterns: [
    'main',
  ],
  platformAutomerge: true,
  labels: [
    'CI-syntax-only',
    'dependencies',
    'renovate',
  ],
  // Renovate's Homebrew manager currently only matches Formula/**. Ignore
  // formulae to avoid duplicating autobump-formula.yml, but leave Casks/**
  // visible in case Renovate adds native cask support later.
  ignorePaths: [
    'Formula/**',
  ],
  packageRules: [
    {
      description: 'Require manual review for GitHub Actions Ubuntu runner updates',
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        'ubuntu',
      ],
      enabled: false,
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
}
